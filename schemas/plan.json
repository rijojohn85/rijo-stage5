{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["files", "steps", "test"],
  "properties": {
    "files": {
      "description": "Repository-relative paths the fix is allowed to change.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "description": "Ordered, concrete steps that make the fix.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "test": {
      "description": "One command that fails before the fix and passes after it.",
      "type": "string",
      "minLength": 1
    }
  }
}
